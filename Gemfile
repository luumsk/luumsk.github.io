source "https://rubygems.org"

# Local preview only. GitHub Pages builds the live site with its own Jekyll,
# so this file doesn't affect deployment. (The "github-pages" gem doesn't
# support Ruby 4 yet, hence plain Jekyll here.)
gem "jekyll", "~> 4.3"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
end

# Standard libs no longer bundled with newer Ruby
gem "webrick"
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
gem "ostruct"
